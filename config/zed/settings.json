// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "agent_servers": {
    "codex-acp": {
      "type": "registry"
    }
  },
  "icon_theme": "Zed (Default)",
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "session": {
    "trust_all_worktrees": true
  },
  "vim_mode": true,
  "base_keymap": "VSCode",
  "vim": {
    "use_system_clipboard": "always",
    "highlight_on_yank_duration": 200
  },
  "relative_line_numbers": "enabled",
  "gutter": {
    "line_numbers": true
  },
  "minimap": {
    "show": "never"
  },
  "colorize_brackets": true,
  "tab_size": 2,
  "format_on_save": "off",
  "soft_wrap": "bounded",
  "preferred_line_length": 120,
  "show_wrap_guides": true,
  "wrap_guides": [100, 120],
  "ui_font_size": 16,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 14.0,
  "buffer_line_height": { "custom": 1.5714285714 }, // 22 px at a 14 px font size
  "buffer_font_features": {
    "calt": true,
    "liga": true
  },
  "toolbar": {
    "breadcrumbs": false
  },
  "diff_view_style": "unified",
  "project_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "right"
  },
  "agent": {
    "dock": "right",
    "threads_sidebar": {
      "position": "right"
    }
  },
  "languages": {
    // Override bundled language defaults that take precedence over global settings.
    "Astro": { "format_on_save": "off" },
    "Git Commit": { "soft_wrap": "bounded", "preferred_line_length": 120 },
    "Go": { "format_on_save": "off" },
    "JSONC": {
      "formatter": {
        "language_server": {
          "name": "json-language-server"
        }
      }
    },
    "Markdown": { "soft_wrap": "bounded" },
    "Plain Text": { "soft_wrap": "bounded" },
    "Rust": { "format_on_save": "off" },
    "Zig": { "format_on_save": "off" }
  },
  "auto_install_extensions": {
    "vague": true
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Vague",
  },
  "theme_overrides": {
    "Vague": {
      // Lighter UI surfaces distinguish panels and bars from the editor.
      "background": "#202028",
      "surface.background": "#202028",
      "panel.background": "#202028",
      "toolbar.background": "#202028",
      "tab_bar.background": "#202028",
      "tab.inactive_background": "#202028",
      "title_bar.background": "#202028",
      "title_bar.inactive_background": "#1c1c24",
      "status_bar.background": "#202028",
      "terminal.background": "#202028",
      "elevated_surface.background": "#252530",
      "ghost_element.background": "#00000000",
      "ghost_element.hover": "#30303c",
      "element.hover": "#30303c",
      "border": "#34343f",
      "border.variant": "#2c2c36"
    }
  },
}
