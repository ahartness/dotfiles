// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "Editor && mode == full && vim_mode == normal",
    "bindings": {
      "space w": "workspace::Save",
      "space d": "workspace::SaveWithoutFormat",
      "space q": "pane::CloseActiveItem",
      "space r d": "debugger::Start",
      "space c a": "editor::ToggleCodeActions",
      "space r n": "editor::Rename",
      "space f s": "outline::Toggle",
      "space g d": "editor::GoToDefinition",
      "space g r": "editor::FindAllReferences",
      "space g i": "editor::GoToImplementation",
      "[ d": "editor::GoToPreviousDiagnostic",
      "] d": "editor::GoToDiagnostic",
      "space v": "pane::SplitRight",
      "space b": "pane::SplitDown",
      "space c f": "editor::Format",
      "space s f": "file_finder::Toggle",
      "space s v": "project_symbols::Toggle",
      "space s g": "text_finder::Toggle",
      "space s c": "command_palette::Toggle",
      "alt-a": "editor::SelectAll",
      "shift-j": ["editor::MoveDownByLines", { "lines": 10 }],
      "shift-k": ["editor::MoveUpByLines", { "lines": 10 }],
      "space a q": "agent::ToggleFocus",
    },
  },
  {
    "context": "(Editor && mode == full && vim_mode == normal) || (ProjectPanel && not_editing) || (GitPanel && !Editor && !Picker) || EmptyPane || SharedScreen",
    "bindings": {
      "space r t": "task::Spawn",
      "space g p": "git::Pull",
      "space g c": "git::Branch",
      "space g f": "git::Fetch",
      "space g w": "zed::OpenLog", // Zed's application log
      "space g g": "git_panel::ToggleFocus",
      "space f f": "file_finder::Toggle",
      "space f g": "pane::DeploySearch",
      "space /": "pane::DeploySearch",
      "space c p": "command_palette::Toggle",
      "space e": "project_panel::Toggle",
    },
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual)",
    "bindings": {
      "shift-l": "pane::ActivateNextItem",
      "shift-h": "pane::ActivatePreviousItem",
      "space t": "pane::CloseOtherItems",
      "space a c": "agent::AddSelectionToThread",
    },
  },
  {
    "context": "Editor && mode == full && vim_mode == visual",
    "bindings": {
      "shift-j": "editor::MoveLineDown",
      "shift-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Editor && mode == full && (vim_mode == normal || vim_mode == visual || vim_mode == insert)",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
    },
  },
  {
    "context": "Workspace || (Editor && mode == full) || (ProjectPanel && not_editing)",
    "bindings": {
      "ctrl-h": "workspace::ActivatePaneLeft",
      "ctrl-l": "workspace::ActivatePaneRight",
      "ctrl-k": "workspace::ActivatePaneUp",
      "ctrl-j": "workspace::ActivatePaneDown",
      "ctrl-m": "workspace::ToggleRightDock",
    },
  },
  {
    "context": "(Workspace && !Editor && !Terminal && !Picker && !menu) || (Editor && mode == full && !menu && !showing_completions && !showing_code_actions && !showing_signature_help)",
    "bindings": {
      "ctrl-n": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "ProjectPanel && not_editing",
    "bindings": {
      "a": "project_panel::NewFile",
      "shift-a": "project_panel::NewDirectory",
      "r": "project_panel::Rename",
      "d": "project_panel::Delete",
      "x": "project_panel::Cut",
      "c": "project_panel::Copy",
      "p": "project_panel::Paste",
      "s": "project_panel::OpenSplitHorizontal",
      "shift-s": "project_panel::OpenSplitVertical",
      "enter": "project_panel::OpenPermanent",
      "space e": "workspace::ToggleLeftDock",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "alt-shift-l": "pane::ActivateNextItem",
      "alt-shift-h": "pane::ActivatePreviousItem",
      "alt-shift-n": "workspace::NewTerminal",
      "alt-shift-q": "pane::CloseActiveItem",
      "alt-_": "pane::SplitRight", // Alt+Shift+- on a US keyboard
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "alt-shift-e": "project_panel::Toggle",
      "alt-shift-k": "agent::Toggle",
      "alt-shift-g": "git_panel::Toggle",
      "alt-shift-j": "workspace::ToggleBottomDock",
    },
  },
  {
    "context": "Editor && showing_completions",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "{": "editor::ContextMenuPrevious",
      "up": null,
      "down": null,
    },
  },
  {
    "context": "Editor && showing_code_actions",
    "bindings": {
      "tab": "editor::ContextMenuNext",
      "shift-tab": "editor::ContextMenuPrevious",
      "up": null,
      "down": null,
    },
  },
  {
    "context": "Picker || (Picker > Editor)",
    "bindings": {
      "tab": "menu::SelectNext",
      "shift-tab": "menu::SelectPrevious",
    },
  },
  {
    "context": "Workspace && os == macos",
    "bindings": {
      "cmd-n": null,
      "alt-cmd-b": null,
    },
  },
]
