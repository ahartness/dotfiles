$include /etc/inputrc

# Ignore case when completing file names and commands
set completion-ignore-case on

# Treat Hyphens and underscores as equivalent for completion
set completion-map-case on

# Show all matches immediately when there are multiple
set show-all-if-ambiguous on

# Show matched without requiring a second tab press
set show-all-if-unmodified on

# Add colors to completion results
set colored-stats on
set colored-completion-prefix on

# Mark directories with a trailing slash when completing
set mark-directories on

# Cycle through completion options with TAB and Shift+TAB
TAB: menu-complete
"\e[Z": menu-complete-backward
