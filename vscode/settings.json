{
  // Windows Settings
  "window.commandCenter": false,
  "window.density.editorTabHeight": "compact",
  "window.zoomLevel": 0.5,
  // Editor Settings
  "editor.fontSize": 14,
  "editor.lineHeight": 22,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.rulers": [100, 120],
  "editor.fontLigatures": true,
  "editor.formatOnSave": false,
  "editor.tabSize": 2,
  "editor.lineNumbers": "relative",
  "editor.fontFamily": "JetBrainsMono Nerd Font",
  "editor.minimap.enabled": false,
  "editor.smoothScrolling": true,
  "editor.bracketPairColorization.enabled": true,
  // Workbench Settings
  "workbench.sideBar.location": "left",
  "workbench.startupEditor": "none",
  "diffEditor.renderSideBySide": false,
  "breadcrumbs.enabled": false,
  // Extensions Settings
  "extensions.experimental.affinity": {
    "vscode.vim": 1
  },
  // Vim basic settings
  "vim.easymotion": true,
  "vim.surround": true,
  "vim.highlightedyank.enable": true,
  "vim.hlsearch": true,
  "vim.leader": " ",
  "vim.neovimUseConfigFile": true,
  "vim.enableNeovim": true,
  "vim.neovimConfigPath": "/home/hrtns/.config/nvim/init.lua",
  "vim.neovimPath": "/home/hrtns/.config/nvim",
  "vim.useSystemClipboard": true,
  // "vim.vimrc.enable": true,
  // "vim.vimrc.path": "/Users/andrewhartness/.config/nvim/init.lua",
  // Vim Bindings
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": ["<Esc>"],
      "when": ["editorFocus"],
      "commands": [":nohl"],
      "silent": true
    }
  ],
  "vim.normalModeKeyBindings": [
    {
      "before": ["<leader>", "g", "r"],
      "commands": ["editor.action.goToReferences"]
    },
    {
      "before": ["<leader>", "g", "i"],
      "commands": ["editor.action.goToImplementation"]
    },
    {
      "before": ["<leader>", "g", "d"],
      "commands": ["editor.action.goToDeclaration"]
    },
    {
      "before": ["<leader>", "e"],
      "commands": ["workbench.action.toggleSidebarVisibility"]
    },
    {
      "before": ["K"],
      "commands": [
        {
          "command": "cursorMove",
          "args": {
            "to": "up",
            "by": "line",
            "value": 10
          }
        }
      ]
    },
    {
      "before": ["J"],
      "commands": [
        {
          "command": "cursorMove",
          "args": {
            "to": "down",
            "by": "line",
            "value": 10
          }
        }
      ]
    },
    {
      "before": ["<leader>", "s", "f"],
      "commands": ["workbench.action.quickOpen"]
    },
    {
      "before": ["<leader>", "s", "v"],
      "commands": [
        {
          "command": "workbench.action.quickOpen",
          "args": "#"
        }
      ]
    },
    {
      "before": ["<leader>", "s", "g"],
      "commands": [
        {
          "command": "workbench.action.quickOpen",
          "args": "%"
        }
      ]
    },
    {
      "before": ["<leader>", "s", "c"],
      "commands": ["workbench.action.showCommands"]
    },
    {
      "before": ["<leader>", "c", "f"],
      "commands": ["editor.action.formatDocument"]
    },
    {
      "before": ["L"],
      "commands": ["workbench.action.nextEditor"]
    },
    {
      "before": ["H"],
      "commands": ["workbench.action.previousEditor"]
    }
  ],
  "vim.visualModeKeyBindings": [
    {
      "before": ["J"],
      "commands": ["editor.action.moveLinesDownAction"]
    },
    {
      "before": ["K"],
      "commands": ["editor.action.moveLinesUpAction"]
    }
  ],
  "[jsonc]": {
    "editor.defaultFormatter": "vscode.json-language-features"
  },
  "workbench.activityBar.location": "top",
  "git.openRepositoryInParentFolders": "never",
  "terminal.integrated.initialHint": false,
  "chat.viewSessions.orientation": "stacked",
  "workbench.colorTheme": "Vague",
  // Theme overrides for vague - Adds Contract between editor window and panels
  "workbench.colorCustomizations": {
    "[Vague]": {
      "activityBar.background": "#202028",
      "activityBarTop.background": "#202028",
      "sideBar.background": "#202028",
      "sideBarSectionHeader.background": "#202028",
      "panel.background": "#202028",
      "editorGroupHeader.tabsBackground": "#202028",
      "editorGroupHeader.noTabsBackground": "#202028",
      "tab.inactiveBackground": "#202028",
      "titleBar.activeBackground": "#202028",
      "titleBar.inactiveBackground": "#1c1c24",
      "statusBar.background": "#202028",
      "statusBar.noFolderBackground": "#202028",
      "menu.background": "#252530",
      "quickInput.background": "#252530",
      "notifications.background": "#252530",
      "editorWidget.background": "#252530",
      "editorHoverWidget.background": "#252530",
      "editorSuggestWidget.background": "#252530",
      "menu.selectionBackground": "#55556f",
      "quickInputList.focusBackground": "#55556f",
      "editorSuggestWidget.selectedBackground": "#55556f",
      "list.focusBackground": "#55556f",
      "list.activeSelectionBackground": "#55556f",
      "list.hoverBackground": "#4b4b61",
      "toolbar.hoverBackground": "#30303c",
      "toolbar.activeBackground": "#55556f",
      "statusBarItem.hoverBackground": "#4b4b61",
      "tab.hoverBackground": "#30303c",
      "activityBar.border": "#34343f",
      "sideBar.border": "#34343f",
      "panel.border": "#34343f",
      "titleBar.border": "#34343f",
      "statusBar.border": "#34343f",
      "menu.border": "#34343f",
      "widget.border": "#34343f",
      "editorWidget.border": "#34343f",
      "editorHoverWidget.border": "#34343f",
      "editorSuggestWidget.border": "#34343f",
      "notifications.border": "#34343f",
      "editorGroup.border": "#2c2c36",
      "editorGroupHeader.tabsBorder": "#2c2c36",
      "sideBarSectionHeader.border": "#2c2c36",
      "tab.border": "#2c2c36"
    }
  },
  "git.confirmSync": false
}
